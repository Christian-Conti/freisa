 def _gb(b):
     return f"{b / 2**30:.1f}G"
 
+
+_TUI_EVENT_LOCK = threading.Lock()
+
+
+def _tui_event(path, event, **fields):
+    """Write one structured monitor event when FREISA is launched from the TUI."""
+    if not path:
+        return
+    record = {"event": event, "timestamp": time.time(), **fields}
+    try:
+        with _TUI_EVENT_LOCK:
+            with open(path, "a", encoding="utf-8") as stream:
+                stream.write(json.dumps(record, default=str, separators=(",", ":")) + "\n")
+                stream.flush()
+    except OSError:
+        pass
+
+
